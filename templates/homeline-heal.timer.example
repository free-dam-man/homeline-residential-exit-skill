# OPTIONAL. Only install if the operator wants scheduled node swapping; "minute-check-only" mode
# (gateway watchdog alone, human fixes dead nodes on request) is a valid, supported choice.
# Replace <cc>/<CC>/<...>. Interval is the operator's choice (12h shown; *:0/30 = every 30 min).
# /etc/systemd/system/homeline-heal-<cc>.timer
[Unit]
Description=Homeline heal <CC>
[Timer]
OnCalendar=*-*-* 00/12:07:00
RandomizedDelaySec=300
Persistent=true
Unit=homeline-heal-<cc>.service
[Install]
WantedBy=timers.target

# /etc/systemd/system/homeline-heal-<cc>.service
# [Unit]
# Description=Homeline heal <CC>
# After=docker.service
# [Service]
# Type=oneshot
# Nice=10
# MemoryMax=80M
# TimeoutStartSec=280
# Environment=HOMELINE_BASE=<HOMELINE_BASE> GATEWAY_IMAGE=<GATEWAY_IMAGE>
# ExecStart=<HOMELINE_BASE>/heal/heal.sh <CC> vpngw-<cc>-gateway <LINE_DIR> <SOCKS_PORT>
