{
  "log": { "loglevel": "warning" },
  "inbounds": [
    {
      "port": "<XRAY_PORT>",
      "protocol": "vless",
      "settings": {
        "clients": [{ "id": "<UUID_GENERATE_WITH_XRAY_UUID>", "flow": "xtls-rprx-vision" }],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "dest": "<SNI_HOST>:443",
          "serverNames": ["<SNI_HOST>"],
          "privateKey": "<REALITY_PRIVATE_KEY_FROM_XRAY_X25519>",
          "shortIds": ["<SHORT_ID_RANDOM_HEX_8_BYTES>"]
        }
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "socks",
      "settings": {
        "servers": [
          {
            "address": "127.0.0.1",
            "port": "<SOCKS_PORT>",
            "users": [{ "user": "<GATE_USER_FROM_DOTENV>", "pass": "<GATE_PASS_FROM_DOTENV>" }]
          }
        ]
      }
    },
    { "tag": "block", "protocol": "blackhole" }
  ],
  "routing": { "rules": [{ "type": "field", "network": "udp", "outboundTag": "block" }] }
}
