# One .env per line (<LINE_DIR>/.env), mode 600. Names must be exactly GATE_USER / GATE_PASS:
# the gateway entrypoint, the patrol probe and the Xray SOCKS outbound all read them.
# Generate on the VPS (never paste the result into chat, git or screenshots):
#   printf 'GATE_USER=gw%s\nGATE_PASS=%s\n' "$(openssl rand -hex 3)" "$(openssl rand -hex 16)" > .env && chmod 600 .env
GATE_USER=<GENERATE_ON_VPS_DO_NOT_COMMIT>
GATE_PASS=<GENERATE_ON_VPS_DO_NOT_COMMIT>
