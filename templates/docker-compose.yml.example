# OPTIONAL compose form of the main-path gateway (equivalent to the `docker run` in SKILL.md Section 3, step 5).
# Copy to <LINE_DIR>/docker-compose.yml, replace <...>. One gateway per country line; never share ports/dirs.
# There is deliberately NO manager container and NO /var/run/docker.sock mount (see SKILL.md 2A: docker.sock = root-equivalent).
# Node choice = scan.sh; optional node swapping = heal.sh on the host.
services:
  gateway:
    image: <GATEWAY_IMAGE>            # e.g. homeline-gw:v2, built from gateway-v2.Dockerfile.example
    container_name: vpngw-<NAME>-gateway
    cap_add: [NET_ADMIN]
    devices: [/dev/net/tun]
    mem_limit: 48m
    ports:
      # SOCKS only on loopback. 0.0.0.0 here is a security incident.
      - "127.0.0.1:<SOCKS_PORT>:1080"
    volumes:
      - ./ovpn:/vpn                   # client.ovpn + auth.txt (both 600)
    env_file: .env                    # GATE_USER / GATE_PASS, exact names
    restart: unless-stopped
